generator client { provider = "prisma-client-js" output = "../node_modules/@flypal/master-client" }
datasource db { provider = "postgresql" url = env("MASTER_DATABASE_URL") }
enum TenantStatus { ACTIVE SUSPENDED DISABLED DELETED }
model Tenant { id String @id @default(uuid()) @db.Uuid slug String @unique name String status TenantStatus @default(ACTIVE) dbHost String @map("db_host") dbName String @map("db_name") dbUser String @map("db_user") dbPassword String @map("db_password") createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") sessions ActiveSession[] backups TenantBackup[] logs TenantAuditLog[] @@map("tenants") }
model ActiveSession { id String @id @default(uuid()) @db.Uuid tenantId String @map("tenant_id") @db.Uuid userId String @map("user_id") expiresAt DateTime @map("expires_at") tenant Tenant @relation(fields:[tenantId], references:[id]) @@index([tenantId]) @@map("active_sessions") }
model TenantAuditLog { id String @id @default(uuid()) @db.Uuid tenantId String @map("tenant_id") @db.Uuid action String actorId String? @map("actor_id") createdAt DateTime @default(now()) @map("created_at") tenant Tenant @relation(fields:[tenantId], references:[id]) @@index([tenantId]) @@map("tenant_audit_logs") }
model TenantBackup { id String @id @default(uuid()) @db.Uuid tenantId String @map("tenant_id") @db.Uuid objectKey String @map("object_key") createdAt DateTime @default(now()) @map("created_at") tenant Tenant @relation(fields:[tenantId], references:[id]) @@index([tenantId]) @@map("tenant_backups") }

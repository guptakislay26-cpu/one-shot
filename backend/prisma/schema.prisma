generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum RoleName { SUPER_ADMIN STATION_ADMIN PLANNING_ENGINEER PEOPLE_MANAGER CERTIFYING_STAFF TECHNICIAN STOREKEEPER QUALITY_INSPECTOR FINANCE_OFFICER VIEWER CUSTOMER }
